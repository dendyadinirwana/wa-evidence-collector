# WhatsApp bridge configuration (example).
# Copy to .env next to the bridge binary when you need non-defaults.
# The bridge reads these from the environment; see README.md.

# Port for the bridge REST API.
WHATSAPP_BRIDGE_PORT=8080

# Set to false to disable outbound webhooks entirely.
WEBHOOK_ENABLED=false

# Download incoming media automatically. False leaves downloads to
# /api/download (used by the collector on demand).
WHATSAPP_AUTO_DOWNLOAD_MEDIA=false

# Forward messages sent by self (true/false).
FORWARD_SELF=false

# Label shown for this connection in WhatsApp > Linked Devices.
# Takes effect at pair time only; re-pair to change it.
# WHATSAPP_DEVICE_NAME=wa-evidence-collector

# Bridge REST API URL (used by the MCP server and the collector).
WHATSAPP_API_URL=http://localhost:8080/api
